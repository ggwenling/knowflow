# Environment injection only; no .env auto-loading. Internal secret is required.
# Optional installed-package override: KNOWFLOW_CONTRACT_PATH=/mounted/protocol.schema.json
KNOWFLOW_INTERNAL_SHARED_SECRET=
KNOWFLOW_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
KNOWFLOW_EMBEDDING_MODEL=BAAI/bge-m3
KNOWFLOW_EMBEDDING_DIMENSIONS=1024
KNOWFLOW_EMBEDDING_KEY_ENV=EMBEDING_KEY
KNOWFLOW_EMBEDDING_TIMEOUT_SECONDS=20
KNOWFLOW_EMBEDDING_MAX_BATCH_ITEMS=32
KNOWFLOW_EMBEDDING_MAX_TEXT_CODEPOINTS=800
KNOWFLOW_LLM_BASE_URL=https://api.deepseek.com
KNOWFLOW_LLM_MODEL=deepseek-flash
KNOWFLOW_LLM_KEY_ENV=DEEPSEEK_API_KEY
# Bounded answer repair is on by default; unset, empty, and whitespace are equivalent.
# Only off/false/0/no (case-insensitive, with surrounding whitespace allowed) disable it.
# Unknown values remain enabled and produce an unrecognized_kept_enabled warning.
# A supported citation failure can make at most one extra generation (two total).
# Set to off as a rollback switch.
KNOWFLOW_ANSWER_REPAIR=on
# Provider API keys belong only in the ignored .env; keep these example values blank.
EMBEDING_KEY=
DEEPSEEK_API_KEY=
