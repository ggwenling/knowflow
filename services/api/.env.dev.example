# Development-only credentials. Replace each placeholder with a unique random value.
# This env file is consumed only by compose.dev.yml and must never be used in production.
KNOWFLOW_DEV_POSTGRES_PASSWORD=replace-with-local-random-admin-password
KNOWFLOW_DEV_MIGRATOR_PASSWORD=replace-with-local-random-migrator-password
KNOWFLOW_DEV_APP_PASSWORD=replace-with-local-random-app-password
KNOWFLOW_DEV_AI_PASSWORD=replace-with-local-random-ai-password
KNOWFLOW_DEV_MINIO_ROOT_USER=knowflow-local-dev
KNOWFLOW_DEV_MINIO_ROOT_PASSWORD=replace-with-local-random-minio-password
# Used by the API process; never reuse this local value outside development.
KNOWFLOW_INTERNAL_SHARED_SECRET=replace-with-a-local-random-secret-at-least-32-characters-long
