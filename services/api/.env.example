# Local-only Java API settings; never place real credentials in this template.
KNOWFLOW_DATABASE_URL=jdbc:postgresql://localhost:5432/knowflow
KNOWFLOW_DATABASE_USERNAME=knowflow_app
KNOWFLOW_DATABASE_PASSWORD=
# Used only by the db-migrate Spring profile; keep it separate from the app role.
KNOWFLOW_MIGRATION_DATABASE_URL=jdbc:postgresql://localhost:5432/knowflow
KNOWFLOW_MIGRATION_DATABASE_USERNAME=knowflow_migrator
KNOWFLOW_MIGRATION_DATABASE_PASSWORD=
KNOWFLOW_AI_BASE_URL=http://localhost:8000
KNOWFLOW_INDEXING_SCHEDULER_ENABLED=false
# Used only with SPRING_PROFILES_ACTIVE=database,storage.
KNOWFLOW_STORAGE_ENDPOINT=http://localhost:59000
KNOWFLOW_STORAGE_BUCKET=knowflow-documents
KNOWFLOW_STORAGE_ACCESS_KEY=
KNOWFLOW_STORAGE_SECRET_KEY=
KNOWFLOW_STORAGE_REQUEST_TIMEOUT=10s
# Intentionally blank: generate a random local value before starting the service.
KNOWFLOW_INTERNAL_SHARED_SECRET=
