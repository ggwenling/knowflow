# Copy to infra/.env for a local development environment.
# Generate fresh random values; do not use this example as credentials.
KNOWFLOW_DEV_POSTGRES_PASSWORD=replace-with-random-value
KNOWFLOW_DEV_MIGRATOR_PASSWORD=replace-with-random-value
KNOWFLOW_DEV_APP_PASSWORD=replace-with-random-value
KNOWFLOW_DEV_AI_PASSWORD=replace-with-random-value
KNOWFLOW_DEV_MINIO_ROOT_USER=knowflow-local
KNOWFLOW_DEV_MINIO_ROOT_PASSWORD=replace-with-random-value
KNOWFLOW_INTERNAL_SHARED_SECRET=replace-with-at-least-32-random-characters
KNOWFLOW_E2E_DUMMY_EMBEDDING_KEY=replace-with-64-random-characters
KNOWFLOW_E2E_DUMMY_LLM_KEY=replace-with-64-random-characters
KNOWFLOW_WEB_HOST_BIND=127.0.0.1
KNOWFLOW_WEB_PORT=3000
