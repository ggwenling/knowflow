# KnowFlow 生产环境变量清单（草案）
#
# 用法：复制为 ../.env.production（或由部署系统的环境注入提供），逐项填写。
# 规则：
#   1. 本文件只保留变量名，**任何值都不要写回仓库**。
#   2. 真实密钥放进被 .gitignore 覆盖的文件（`services/ai/.env`、`.env.production`），或直接由环境注入。
#   3. 键名不改：下面每个变量都被代码按名读取，改名等于改代码。

# ── 运行形态 ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=database,storage      # API 必需；缺 database 则业务 bean 不装配
SERVER_PORT=8080
NODE_ENV=production                          # Web 必需；否则 session cookie 不带 Secure

# ── 发布与镜像 ────────────────────────────────────────────────────────────
# 镜像引用为 <KNOWFLOW_IMAGE_REPOSITORY>/{api,ai,web}:<KNOWFLOW_RELEASE>。
# KNOWFLOW_RELEASE 必须不可变（提交 sha 或语义版本），禁止 local / latest；
# 构建、推送与 digest 记录见 deploy/scripts/release.ps1（本地 registry 示例：
#   127.0.0.1:5001/knowflow）。
KNOWFLOW_IMAGE_REPOSITORY=
KNOWFLOW_RELEASE=
# 数据库回滚演练：仅迁移到该版本（留空=最新）；正式发布保持留空。
# 流程见 deploy/scripts/db-backup.ps1 与 db-restore.ps1。
KNOWFLOW_MIGRATION_TARGET=

# ── PostgreSQL（超级用户：仅用于 postgres 容器初始化和管理）──────────────
KNOWFLOW_POSTGRES_SUPERUSER_PASSWORD=

# ── PostgreSQL（API 运行时角色：读写业务表，无 DDL）──────────────────────
KNOWFLOW_DATABASE_URL=jdbc:postgresql://postgres:5432/knowflow
KNOWFLOW_DATABASE_USERNAME=knowflow_app
KNOWFLOW_DATABASE_PASSWORD=

# ── PostgreSQL（迁移角色：只跑 Flyway，权限更高，只给 migrate 服务）────
KNOWFLOW_MIGRATION_DATABASE_URL=jdbc:postgresql://postgres:5432/knowflow
KNOWFLOW_MIGRATION_DATABASE_USERNAME=knowflow_migrator
KNOWFLOW_MIGRATION_DATABASE_PASSWORD=

# ── PostgreSQL（AI 角色：只读检索，无写入权限）──────────────────────────
KNOWFLOW_AI_DATABASE_PASSWORD=
# 将下方 CHANGE_ME 替换为同一 AI 角色密码，并对 URL 中的特殊字符做百分号编码。
KNOWFLOW_AI_DATABASE_URL=postgresql://knowflow_ai:CHANGE_ME@postgres:5432/knowflow

# ── 对象存储（S3 兼容）──────────────────────────────────────────────────
KNOWFLOW_STORAGE_ENDPOINT=http://minio:9000
KNOWFLOW_STORAGE_BUCKET=knowflow-documents
KNOWFLOW_STORAGE_ACCESS_KEY=
KNOWFLOW_STORAGE_SECRET_KEY=
KNOWFLOW_STORAGE_REQUEST_TIMEOUT=10s

# ── 服务间认证 ──────────────────────────────────────────────────────────
# 同一个值必须同时给 api 与 ai；ai 侧用常量时间比较，不落日志。
KNOWFLOW_INTERNAL_SHARED_SECRET=

# ── 服务寻址 ────────────────────────────────────────────────────────────
KNOWFLOW_AI_BASE_URL=http://ai:8000          # API → AI
KNOWFLOW_JAVA_BASE_URL=http://api:8080       # AI → API（heartbeat / completion / source read）
KNOWFLOW_API_BASE_URL=http://api:8080        # Web → API
KNOWFLOW_CONTRACT_PATH=/workspace/contracts/schemas/protocol.schema.json

# ── 索引调度（API 侧）───────────────────────────────────────────────────
KNOWFLOW_INDEXING_SCHEDULER_ENABLED=true
KNOWFLOW_INDEXING_POLL_DELAY_MILLIS=250
KNOWFLOW_INDEXING_RUNTIME_PROFILE_ID=
KNOWFLOW_QUESTION_MAX_CONCURRENT=4           # API 与 AI 两侧共用语义，默认 4，范围 1..32

# ── AI 运行时档案 ───────────────────────────────────────────────────────
# 必须与 API 的 KNOWFLOW_INDEXING_RUNTIME_PROFILE_ID 一致，否则派工被拒。
KNOWFLOW_RUNTIME_PROFILE_ID=

# ── Embedding（受运行时校验：必须 https + 固定主机 + 固定模型/维度）────
KNOWFLOW_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
KNOWFLOW_EMBEDDING_MODEL=BAAI/bge-m3
KNOWFLOW_EMBEDDING_DIMENSIONS=1024
KNOWFLOW_EMBEDDING_KEY_ENV=KNOWFLOW_EMBEDDING_API_KEY
KNOWFLOW_EMBEDDING_TIMEOUT_SECONDS=20
KNOWFLOW_EMBEDDING_MAX_BATCH_ITEMS=32
KNOWFLOW_EMBEDDING_MAX_TEXT_CODEPOINTS=800
KNOWFLOW_EMBEDDING_API_KEY=                  # 由 KEY_ENV 指向，勿改键名

# ── LLM（受运行时校验：必须 https://api.deepseek.com + model=deepseek-flash）
KNOWFLOW_LLM_BASE_URL=https://api.deepseek.com
KNOWFLOW_LLM_MODEL=deepseek-flash
KNOWFLOW_LLM_KEY_ENV=KNOWFLOW_LLM_API_KEY
KNOWFLOW_LLM_API_KEY=                        # 由 KEY_ENV 指向，勿改键名

# ── Provider 有界重试（5xx / 超时 / 429 可重试；4xx 不重试）─────────────
# 每次尝试都独立计入预算账本；预算软停或硬上限会立即终止重试。
KNOWFLOW_PROVIDER_RETRY_MAX_ATTEMPTS=3
KNOWFLOW_PROVIDER_RETRY_BASE_SECONDS=0.5
KNOWFLOW_PROVIDER_RETRY_TOTAL_SECONDS=25
# 429 优先使用 Retry-After；超过总时长上限则放弃重试。

# ── Provider 就绪探针（GET /models，不调用 chat/embeddings，不耗 token）──
KNOWFLOW_PROVIDER_PROBE_TIMEOUT_SECONDS=5
KNOWFLOW_PROVIDER_PROBE_TTL_SECONDS=10

# ── Provider 预算门禁（fail-closed，三件套必需）────────────────────────
# 缺任一项 / 文件不可读 / 策略过期 → 每次 provider 调用都被拒绝，
# 索引与问答返回 503 AI_PROCESSING_FAILED（日志 reason=BUDGET_CONFIGURATION_REQUIRED）。
#
# 账本：独立命名卷 budget-ledger 内的 SQLite 路径，由 compose 自动挂载。
KNOWFLOW_BUDGET_LEDGER_PATH=/var/lib/knowflow-budget/budget-ledger.sqlite3
# 价格/策略：容器内固定路径，由下面的宿主目录只读挂载到 /etc/knowflow-budget。
KNOWFLOW_BUDGET_PRICE_FILE=/etc/knowflow-budget/PRICE_FILE.json
KNOWFLOW_BUDGET_POLICY_FILE=/etc/knowflow-budget/POLICY_FILE.json
# 可选单轮额度。留空时沿用项目预算。启用时两项必须同时填写，
# 同轮采集器和 AI 服务使用相同的 ID、额度和持久账本。4 元填 4000000。
KNOWFLOW_BUDGET_RUN_ID=
KNOWFLOW_BUDGET_RUN_LIMIT_MICROYUAN=
# 宿主目录：必须同时包含 PRICE_FILE.json 与 POLICY_FILE.json。
# 来源为授权的 provider 价目/策略文件；禁止提交仓库（.blindtest* 已被 .gitignore 覆盖）。
# 生产变更价格/策略时替换该目录内容并重启 ai，不要修改文件内容以外的代码。
KNOWFLOW_BUDGET_DIR=

# ── Web 展示模式 ────────────────────────────────────────────────────────
# external = 走真实 provider，生产必须用 external；
# synthetic = 合成回答，仅用于演示/E2E，不能代表生产链路。
KNOWFLOW_WEB_MODEL_MODE=external

# ── 入口 TLS（仅 edge 暴露宿主端口）─────────────────────────────────────
KNOWFLOW_EDGE_HOST_BIND=127.0.0.1
KNOWFLOW_EDGE_HTTPS_PORT=3443
# 证书目录（相对 deploy/ 或绝对路径），必须含 fullchain.pem 与 privkey.pem。
# 本地演练用 deploy/scripts/generate-self-signed-cert.ps1 生成；生产替换为正式证书。
KNOWFLOW_TLS_DIR=./tls

# ── 受控出网（仅 ai 使用）───────────────────────────────────────────────
# ai 不再直连 provider-egress，只能经 egress-proxy 出网；白名单在
# deploy/egress/squid.conf 中强制（仅 api.deepseek.com 与 api.siliconflow.cn）。
# 指向组织已有的白名单正向代理时覆盖此项（必须同样只放行 provider 域名）。
KNOWFLOW_EGRESS_HTTPS_PROXY=http://egress-proxy:3128
# 内部服务名不走代理；provider 调用仍走。
KNOWFLOW_EGRESS_NO_PROXY=api,postgres,minio,edge,localhost,127.0.0.1

# ── 日志（对应 #14 审计 R1）─────────────────────────────────────────────
KNOWFLOW_LOG_MAX_SIZE=50m
KNOWFLOW_LOG_MAX_FILE=5
