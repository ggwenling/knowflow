# KnowFlow 生产环境变量清单（草案）
#
# 用法：复制为 ../.env.production（或由部署系统的环境注入提供），逐项填写。
# 规则：
#   1. 本文件只保留变量名，**任何值都不要写回仓库**。
#   2. 真实密钥放进被 .gitignore 覆盖的文件（`services/ai/.env`、`.env.production`），或直接由环境注入。
#   3. 键名不改：下面每个变量都被代码按名读取，改名等于改代码。

# ── 运行形态 ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=database,storage      # API 必需；缺 database 则业务 bean 不装配
SERVER_PORT=8080
NODE_ENV=production                          # Web 必需；否则 session cookie 不带 Secure

# ── PostgreSQL（API 运行时角色：读写业务表，无 DDL）──────────────────────
KNOWFLOW_DATABASE_URL=jdbc:postgresql://postgres:5432/knowflow
KNOWFLOW_DATABASE_USERNAME=knowflow_app
KNOWFLOW_DATABASE_PASSWORD=

# ── PostgreSQL（迁移角色：只跑 Flyway，权限更高，只给 migrate 服务）────
KNOWFLOW_MIGRATION_DATABASE_URL=jdbc:postgresql://postgres:5432/knowflow
KNOWFLOW_MIGRATION_DATABASE_USERNAME=knowflow_migrator
KNOWFLOW_MIGRATION_DATABASE_PASSWORD=

# ── PostgreSQL（AI 角色：只读检索，无写入权限）──────────────────────────
KNOWFLOW_AI_DATABASE_URL=postgresql://knowflow_ai:CHANGE_ME@postgres:5432/knowflow

# ── 对象存储（S3 兼容）──────────────────────────────────────────────────
KNOWFLOW_STORAGE_ENDPOINT=http://minio:9000
KNOWFLOW_STORAGE_BUCKET=knowflow-documents
KNOWFLOW_STORAGE_ACCESS_KEY=
KNOWFLOW_STORAGE_SECRET_KEY=
KNOWFLOW_STORAGE_REQUEST_TIMEOUT=10s

# ── 服务间认证 ──────────────────────────────────────────────────────────
# 同一个值必须同时给 api 与 ai；ai 侧用常量时间比较，不落日志。
KNOWFLOW_INTERNAL_SHARED_SECRET=

# ── 服务寻址 ────────────────────────────────────────────────────────────
KNOWFLOW_AI_BASE_URL=http://ai:8000          # API → AI
KNOWFLOW_JAVA_BASE_URL=http://api:8080       # AI → API（heartbeat / completion / source read）
KNOWFLOW_API_BASE_URL=http://api:8080        # Web → API
KNOWFLOW_CONTRACT_PATH=/workspace/contracts/schemas/protocol.schema.json

# ── 索引调度（API 侧）───────────────────────────────────────────────────
KNOWFLOW_INDEXING_SCHEDULER_ENABLED=true
KNOWFLOW_INDEXING_POLL_DELAY_MILLIS=250
KNOWFLOW_INDEXING_RUNTIME_PROFILE_ID=
KNOWFLOW_QUESTION_MAX_CONCURRENT=4           # API 与 AI 两侧共用语义，默认 4，范围 1..32

# ── AI 运行时档案 ───────────────────────────────────────────────────────
# 必须与 API 的 KNOWFLOW_INDEXING_RUNTIME_PROFILE_ID 一致，否则派工被拒。
KNOWFLOW_RUNTIME_PROFILE_ID=

# ── Embedding（受运行时校验：必须 https + 固定主机 + 固定模型/维度）────
KNOWFLOW_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
KNOWFLOW_EMBEDDING_MODEL=BAAI/bge-m3
KNOWFLOW_EMBEDDING_DIMENSIONS=1024
KNOWFLOW_EMBEDDING_KEY_ENV=KNOWFLOW_EMBEDDING_API_KEY
KNOWFLOW_EMBEDDING_TIMEOUT_SECONDS=20
KNOWFLOW_EMBEDDING_MAX_BATCH_ITEMS=32
KNOWFLOW_EMBEDDING_MAX_TEXT_CODEPOINTS=800
KNOWFLOW_EMBEDDING_API_KEY=                  # 由 KEY_ENV 指向，勿改键名

# ── LLM（受运行时校验：必须 https://api.deepseek.com + model=deepseek-flash）
KNOWFLOW_LLM_BASE_URL=https://api.deepseek.com
KNOWFLOW_LLM_MODEL=deepseek-flash
KNOWFLOW_LLM_KEY_ENV=KNOWFLOW_LLM_API_KEY
KNOWFLOW_LLM_API_KEY=                        # 由 KEY_ENV 指向，勿改键名

# ── Web 展示模式 ────────────────────────────────────────────────────────
# synthetic = 合成回答（仅演示/E2E）；真实 provider 上线前必须确认为真实模式。
KNOWFLOW_WEB_MODEL_MODE=synthetic

# ── 宿主绑定（仅 web 暴露端口）──────────────────────────────────────────
KNOWFLOW_WEB_HOST_BIND=127.0.0.1
KNOWFLOW_WEB_PORT=3000

# ── 日志（对应 #14 审计 R1）─────────────────────────────────────────────
KNOWFLOW_LOG_MAX_SIZE=50m
KNOWFLOW_LOG_MAX_FILE=5
