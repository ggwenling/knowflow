      "internalBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Java/Python 服务凭证，租约写操作另需执行令牌"
      }
    },
    "responses": {
      "Error": {
        "description": "错误体包含错误码、可重试性与请求 ID",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas/protocol.schema.json#/$defs/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "PublicSource": {
        "type": "object",
        "required": [
          "contract_version",
          "source_id",
          "document_id",
          "content_version_id",
          "index_version_id",
          "chunk_id",
          "locator",
          "quote"
        ],
        "properties": {
          "contract_version": {
            "$ref": "./schemas/protocol.schema.json#/$defs/ContractVersion"
          },
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "content_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "index_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "chunk_id": {
            "type": "string",
            "format": "uuid"
          },
          "locator": {"$ref": "./schemas/protocol.schema.json#/$defs/Locator"},
          "quote": {
            "type": "string"
          }
        }
      },
      "PublicAnswer": {
        "type": "object",
        "required": [
          "contract_version",
          "request_id",
          "answer",
          "has_answer",
          "sources"
        ],
        "properties": {
          "contract_version": {
            "$ref": "./schemas/protocol.schema.json#/$defs/ContractVersion"
          },
          "request_id": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "has_answer": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicSource"
            }
          }
        }
      },
      "PublicStreamEvent": {
        "$ref": "./schemas/protocol.schema.json#/$defs/AnswerStreamEvent"
      }
    }
