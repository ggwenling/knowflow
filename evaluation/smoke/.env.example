# Example only. The smoke runner does not load this file automatically.
# Inject actual values through the managed environment; do not commit credentials.
# User-selected Embedding; live evidence is stored under evidence/.
KNOWFLOW_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
KNOWFLOW_EMBEDDING_MODEL=BAAI/bge-m3
KNOWFLOW_EMBEDDING_DIMENSIONS=1024
KNOWFLOW_EMBEDDING_KEY_ENV=EMBEDING_KEY

KNOWFLOW_LLM_BASE_URL=https://api.deepseek.com
KNOWFLOW_LLM_MODEL=deepseek-flash
KNOWFLOW_LLM_KEY_ENV=DEEPSEEK_API_KEY
# DeepSeek defaults to thinking enabled; this short smoke explicitly disables it.
KNOWFLOW_LLM_THINKING=disabled

# Current managed environment uses EMBEDING_KEY and DEEPSEEK_API_KEY.
# Select the actual bound variable names; do not put key values in this file.
# Legacy single-provider config remains supported when per-role URLs are absent:
# KNOWFLOW_MODEL_BASE_URL=https://your-provider.example/v1
# KNOWFLOW_MODEL_KEY_ENV=OPENAI_API_KEY
